# Copy to .env (git-ignored) and fill in. The API loads it on startup; real environment variables win.

# GitHub App (Phase 3). Read-only permissions: Contents, Metadata, Issues, Pull requests.
# Keep the private key outside the repository, readable only by you (chmod 600).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# How often to check connected repositories for new commits (minutes; 0 disables).
GITHUB_SYNC_INTERVAL_MINUTES=5

# OpenAI: microphone transcription (gpt-live-transcribe) and, with ANALYZER=llm, the model-backed analyzer.
# The account needs credits.
OPENAI_API_KEY=
# ANALYZER=llm

# Recall.ai Desktop SDK (meeting calls captured by apps/desktop). Region of your Recall workspace:
# us-west-2 (pay-as-you-go), us-east-1, eu-central-1 or ap-northeast-1.
RECALL_API_KEY=
RECALL_REGION=us-west-2

# Slack (meeting context from Slack search). Create an internal app from apps/api/slack-app-manifest.json
# at https://api.slack.com/apps, install it to your workspace, then copy its Client ID and Secret here.
# Message text from Slack is never stored; only links to messages are kept.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must match the Redirect URL in the Slack app (default below).
# SLACK_REDIRECT_URL=http://localhost:4000/api/slack/oauth/callback
# Alternative to Connect for an internal app: its "User OAuth Token" (xoxp-...).
# SLACK_USER_TOKEN=
# Key that encrypts the stored Slack token; without it a key file is created next to the data directory.
# UC_SECRET_KEY=
